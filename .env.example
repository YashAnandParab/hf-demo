# Copy to .env and fill in GROQ_API_KEY. Everything else has a working default.

# ---------------------------------------------------------------- database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# A full URL, if set, overrides all of the above.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------- versions ---
# Two RAG versions run side by side, each in its own database so their corpora,
# counts and stats never mix:
#   structured -> POSTGRES_DB          knowledge/story split, data/chunks.json
#   normal     -> NORMAL_POSTGRES_DB   flat baseline,         data/chunks_normal.json
# The normal database is created automatically on its first ingest.
NORMAL_POSTGRES_DB=normal_chunking
# Which version the CLIs start on. query.py asks when --version is not given;
# this is what Enter selects.
RAG_VERSION=structured
# Used only to CREATE the normal database — CREATE DATABASE cannot run inside the
# database being created. Any database that already exists will do.
# POSTGRES_MAINTENANCE_DB=postgres

# -------------------------------------------------------------- embeddings ---
# Local sentence-transformers model, downloaded on first use (~2.3GB for bge-m3).
#   bge-m3 -> 1024   bge-large-en-v1.5 -> 1024   bge-base-en-v1.5 -> 768
#   bge-small-en-v1.5 -> 384
# EMBED_DIM must match: it fixes the vector() column width at table creation, so
# changing it later means re-running ingest.py with --reset. Swapping between two
# models of the SAME dimension still needs --reset — the old vectors are in a
# different space — but no schema change.
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# bge-m3 has an 8192-token window, so a batch of long chunks is much heavier than
# it was at 512. Lower this if you run out of memory on CPU.
EMBED_BATCH_SIZE=16
# EMBED_DEVICE=cuda            # blank = auto
#
# Retrieval instruction prepended to QUERIES only. Derived from EMBED_MODEL:
# bge-m3 wants none, the v1.5 English models want one. Getting it wrong degrades
# retrieval silently, so leave this unset unless you know you need to override it.
# EMBED_QUERY_PREFIX=

# ---------------------------------------------------------------- reranker ---
# local -> cross-encoder    http -> a TEI /rerank server    none -> fusion order
# bge-reranker-v2-m3 is the reranker that pairs with bge-m3 (~2.3GB).
RERANKER_BACKEND=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# http backend only. The full endpoint, and the model name the server reports at
# /info — under http, RERANKER_MODEL is a label for reports, not a download.
#   RERANKER_BACKEND=http
#   RERANKER_URL=http://192.168.0.150:8767/rerank
#   RERANKER_MODEL=Alibaba-NLP/gte-reranker-modernbert-base
RERANKER_TIMEOUT=30
# Must not exceed the server's max_client_batch_size (TEI defaults to 32).
RERANKER_MAX_BATCH=32

# -------------------------------------------------------------- generation ---
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
# gpt-oss models only, ignored for everything else. They spend the token budget on
# a hidden reasoning channel before writing any content: at the default effort they
# routinely exhaust LLM_MAX_TOKENS and return an EMPTY answer. Leave this at "low"
# unless you also raise LLM_MAX_TOKENS well past 1024.
GROQ_REASONING_EFFORT=low

# --------------------------------------------- hypothetical questions (HQ) ---
# One LLM call per chunk at ingest time. Set false to ingest without spending.
HQ_ENABLED=true
HQ_PER_CHUNK=3

# --------------------------------------------------------------- retrieval ---
VECTOR_TOP_K=20
FTS_TOP_K=20
HQ_TOP_K=20
FUSION_TOP_K=30
RERANK_TOP_K=5
RRF_K=60
WEIGHT_VECTOR=1.0
WEIGHT_FTS=0.8
WEIGHT_HQ=1.0

# ------------------------------------------------------ structured RAG only ---
# Stories are never retrieval candidates: they carry no embedding and are absent
# from the full-text index. A story reaches the model only when a knowledge chunk
# that survived reranking cites it via related_story_chunk_ids.
#
# false -> answer from knowledge alone, no narrative in the context
ATTACH_LINKED_STORIES=true
# stories attached per surviving knowledge chunk, in the order the JSON lists them
MAX_LINKED_STORIES=2

# --------------------------------------------------------------- langsmith ---
# Optional. With no key, tracing decorators are a no-op and nothing is sent
# anywhere. With one, each query is a single trace tree: embed -> the three arms
# -> fusion -> rerank -> attached stories -> generation.
#   pip install langsmith
# LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=hf-demo-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# off-switch that works even with a key present
LANGSMITH_TRACING=true

# --------------------------------------------------------------- http api ---
# Origins allowed to call api.py. The Vite dev server is the default; add more
# comma-separated. Deliberately not "*" — this API spends money on a POST body.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------------- misc ---
LOG_LEVEL=INFO
