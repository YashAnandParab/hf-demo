# Copy to .env and fill in GROQ_API_KEY. Everything else has a working default.

# ---------------------------------------------------------------- database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# A full URL, if set, overrides all of the above.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# -------------------------------------------------------------- embeddings ---
# Local sentence-transformers model, downloaded on first use.
#   bge-large-en-v1.5 -> 1024   bge-base-en-v1.5 -> 768   bge-small-en-v1.5 -> 384
# EMBED_DIM must match: it fixes the vector() column width at table creation, so
# changing it later means re-running ingest.py with --reset.
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_DIM=1024
EMBED_BATCH_SIZE=32
# EMBED_DEVICE=cuda            # blank = auto

# ---------------------------------------------------------------- reranker ---
# local -> cross-encoder    none -> keep fusion order (skips loading a 2nd model)
RERANKER_BACKEND=local
RERANKER_MODEL=BAAI/bge-reranker-base

# -------------------------------------------------------------- generation ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
# gpt-oss models only, ignored for everything else. They spend the token budget on
# a hidden reasoning channel before writing any content: at the default effort they
# routinely exhaust LLM_MAX_TOKENS and return an EMPTY answer. Leave this at "low"
# unless you also raise LLM_MAX_TOKENS well past 1024.
GROQ_REASONING_EFFORT=low

# --------------------------------------------- hypothetical questions (HQ) ---
# One LLM call per chunk at ingest time. Set false to ingest without spending.
HQ_ENABLED=true
HQ_PER_CHUNK=3

# --------------------------------------------------------------- retrieval ---
VECTOR_TOP_K=20
FTS_TOP_K=20
HQ_TOP_K=20
FUSION_TOP_K=30
RERANK_TOP_K=5
RRF_K=60
WEIGHT_VECTOR=1.0
WEIGHT_FTS=0.8
WEIGHT_HQ=1.0

# ------------------------------------------------------ structured RAG only ---
# knowledge_only -> the 3 arms search knowledge chunks only; stories arrive via links
# include        -> stories compete in the arms too, so an UNLINKED story is still
#                   reachable. Use this if some stories have no
#                   related_knowledge_chunk_ids.
STORY_RETRIEVAL_MODE=knowledge_only
ATTACH_LINKED_STORIES=true
MAX_LINKED_STORIES=2

# -------------------------------------------------------------------- misc ---
LOG_LEVEL=INFO
